rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: verify user is authenticated via Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: verify caller's UID strictly matches the schoolId
    function isSchoolOwner(schoolId) {
      return isAuthenticated() && request.auth.uid == schoolId;
    }

    // Helper function: verify if caller is an authorized Admin
    // Checks that /admins/{uid} exists and has role == "admin" (case-insensitive check)
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin" ||
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "Admin" ||
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "ADMIN" ||
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true
        );
    }

    // Admin records collection: /admins/{adminUid}
    // An authenticated user can ALWAYS read (get) their own admin record directly using their UID
    // without circular lookup or recursion. Normal school users cannot read other admins or write.
    // Existing verified admins can list and manage admin records.
    match /admins/{adminUid} {
      allow get: if isAuthenticated() && request.auth.uid == adminUid;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // School profile document: /schools/{schoolId}
    match /schools/{schoolId} {
      // Admin can read all schools for inspection; school owner can read own school
      allow read: if isSchoolOwner(schoolId) || isAdmin();

      // New school registration: must be self UID, must register with status == 'pending'
      allow create: if isSchoolOwner(schoolId) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.status == "pending";

      // Status updates: Admin can update any school (approve, reject, activate, deactivate)
      // School owner can update profile information (name, district), but is strictly forbidden from changing status or DISE code!
      allow update: if isAdmin() || (
        isSchoolOwner(schoolId) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'ownerUid', 'id', 'diseCode']))
      );

      // Only an Admin can delete a school
      allow delete: if isAdmin();

      // Subcollection: Students belonging to this school
      match /students/{studentId} {
        allow read: if isSchoolOwner(schoolId) || isAdmin();
        allow write: if isSchoolOwner(schoolId);
      }

      // Subcollection: Marks belonging to this school
      match /marks/{markId} {
        allow read: if isSchoolOwner(schoolId) || isAdmin();
        allow write: if isSchoolOwner(schoolId);
      }

      // All other school-specific subcollections
      match /{allChildren=**} {
        allow read: if isSchoolOwner(schoolId) || isAdmin();
        allow write: if isSchoolOwner(schoolId);
      }
    }

    // Default deny: Block all other database collections and root queries
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
